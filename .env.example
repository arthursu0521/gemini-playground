# Gemini Playground configuration
#
# Copy this file to `.env` for local development:   cp .env.example .env
# `.env` is git-ignored, excluded from `deno deploy` uploads and never served over HTTP.
# In production, set the same variables as *secrets* in the Deno Deploy console
# (or run `deno task deploy:env` to upload your local .env).
#
# Every variable is optional. With nothing set, each visitor brings their own Gemini API key.

# --- Server-side Gemini key (optional) ----------------------------------------
# When both are set, visitors can type ACCESS_PASSWORD instead of their own API key
# and the server uses GEMINI_API_KEY on their behalf. The server key is NEVER used
# without a valid password. ACCESS_PASSWORD must be nonempty; 12+ characters are recommended.
GEMINI_API_KEY=
ACCESS_PASSWORD=

# --- Abuse protection ---------------------------------------------------------
# Comma-separated list of browser origins allowed to open Live sessions / call the API,
# e.g. https://play.example.com,https://example.github.io . Same-origin is always allowed.
# Empty = any origin (the deployment can then be used as a public relay).
ALLOWED_ORIGINS=

# Requests per minute per client IP for the OpenAI-compatible API (0 = unlimited).
RATE_LIMIT_PER_MINUTE=60
# New Live (WebSocket) sessions per minute per client IP (0 = unlimited).
WS_CONNECTIONS_PER_MINUTE=10
# Only enable behind a reverse proxy you control: trust X-Forwarded-For for the client IP.
TRUST_PROXY_HEADERS=false

# --- Defaults -----------------------------------------------------------------
# Model used by /v1/chat/completions when a request does not name one.
DEFAULT_CHAT_MODEL=gemini-3.8-flash
# Model used by /v1/embeddings when a request does not name one.
DEFAULT_EMBEDDING_MODEL=gemini-embedding-001

# --- Operations ---------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
# Local port (default 8000; ignored on Deno Deploy).
# PORT=8000
